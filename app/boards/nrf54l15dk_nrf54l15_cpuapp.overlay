/*
1.  更正P2.06, P2.07, P2.08, P2.09 , P2.10, P0.04 >> PWM OUT 1 Hz, dutycycle 50%
2.  P1.09  MCU_RX1/P1.10 MCU_TX1 (讀取M90E26) 
    P1.11  MCU_RX2/P1.12 MCU_TX2(讀取M90E26)
    P1.13  MCU_RX3/P1.14 MCU_TX3(讀取M90E26)
3. P0.01: Console UART RXD0 , P0.00:Console UART TXD0
*/


/ {
	chosen {
		zephyr,console = &uart30;
		zephyr,shell-uart = &uart30;
		zephyr,uart-mcumgr = &uart30;
		zephyr,bt-mon-uart = &uart30;
		zephyr,bt-c2h-uart = &uart30;
		zephyr,flash-controller = &rram_controller;
		zephyr,flash = &cpuapp_rram;
		zephyr,ieee802154 = &ieee802154;
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>;
			label = "Green LED 0";
			status = "disabled";
		};
		led1: led_1 {
			gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
			label = "Green LED 1";
			status = "disabled";
		};
		led2: led_2 {
			gpios = <&gpio2 7 GPIO_ACTIVE_HIGH>;
			label = "Green LED 2";
			status = "disabled";
		};
		led3: led_3 {
			gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
			label = "Green LED 3";
			status = "disabled";
		};
		status = "disabled";
	};

	pwmleds {
		compatible = "pwm-leds";
		/*
		 * PWM signal can be exposed on GPIO pin only within same domain.
		 * There is only one domain which contains both PWM and GPIO:
		 * PWM20/21/22 and GPIO Port P1.
		 * Only LEDs connected to P1 can work with PWM, for example LED1.
		 */
		status = "disabled";
		pwm_led1: pwm_led_1 {
			pwms = <&pwm20 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			status = "disabled";
		};
	};
};

&uart20 {
    status = "okay";
    pinctrl-0 = <&uart20_custom>;
    current-speed = <9600>;
    m90e26_sensor_a: m90e26a {
        compatible = "atmel,m90e26";
        status = "okay";
    };
};

&uart30 {
    status = "okay";
    current-speed = <115200>;
};

&uart21 {
    status = "okay";
    pinctrl-0 = <&uart21_default>;
    pinctrl-names = "default";
    current-speed = <9600>;
    m90e26_sensor_b: m90e26 {
        compatible = "atmel,m90e26";
        status = "okay";
    };
};

&uart22 {
    status = "okay";
    pinctrl-0 = <&uart22_default>;
    pinctrl-names = "default";
    current-speed = <9600>;
    m90e26_sensor_c: m90e26b {
        compatible = "atmel,m90e26";
        status = "okay";
    };
};

&pinctrl {

    /omit-if-no-ref/ uart20_custom: uart20_custom {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 10)>,
				<NRF_PSEL(UART_RX, 1, 9)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};

	/omit-if-no-ref/ uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 10)>,
				<NRF_PSEL(UART_RX, 1, 9)>;
			low-power-enable;
		};
	};

    /omit-if-no-ref/ uart21_default: uart21_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 12)>,
				<NRF_PSEL(UART_RX, 1, 11)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};

	/omit-if-no-ref/ uart21_sleep: uart21_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 14)>,
				<NRF_PSEL(UART_RX, 1, 13)>;
			low-power-enable;
		};
	};

    /omit-if-no-ref/ uart22_default: uart22_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 14)>,
				<NRF_PSEL(UART_RX, 1, 13)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};

	/omit-if-no-ref/ uart22_sleep: uart22_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 14)>,
				<NRF_PSEL(UART_RX, 1, 13)>;
			low-power-enable;
		};
	};

	/omit-if-no-ref/ uart30_default: uart30_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 0)>,
				<NRF_PSEL(UART_RX, 0, 1)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};

	/omit-if-no-ref/ uart30_sleep: uart30_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 0)>,
				<NRF_PSEL(UART_RX, 0, 1)>;
			low-power-enable;
		};
	};

	/omit-if-no-ref/ pwm20_default: pwm20_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 10)>;
		};
	};

	/omit-if-no-ref/ pwm20_sleep: pwm20_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 10)>;
			low-power-enable;
		};
	};
};

/ {
    aliases {
        gpiopwm0 = &my_output_pin0;
		gpiopwm1 = &my_output_pin1;
        gpiopwm2 = &my_output_pin2;
		gpiopwm3 = &my_output_pin3;
		gpiopwm4 = &my_output_pin4;
		gpiopwm5 = &my_output_pin5;
    };

    leds {
        compatible = "gpio-leds";
        my_output_pin0: my_output_pin0 {
            gpios = <&gpio2 6 GPIO_ACTIVE_HIGH>;
            label = "My 1Hz Output Pin0";
        };
		my_output_pin1: my_output_pin1 {
            gpios = <&gpio2 7 GPIO_ACTIVE_HIGH>;
            label = "My 1Hz Output Pin1";
        };
        my_output_pin2: my_output_pin2 {
            gpios = <&gpio2 8 GPIO_ACTIVE_HIGH>;
            label = "My 1Hz Output Pin2";
        };

		my_output_pin3: my_output_pin3 {
            gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>;
            label = "My 1Hz Output Pin3";
        };

		my_output_pin4: my_output_pin4 {
            gpios = <&gpio2 10 GPIO_ACTIVE_HIGH>;
            label = "My 1Hz Output Pin4";
        };

		my_output_pin5: my_output_pin5 {
            gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
            label = "My 1Hz Output Pin5";
        };
    };
};

//P2.06, P2.07, P2.08, P2.09 , P2.10, P0.04 >> PWM OUT 1 Hz, dutycycle 50%